{
  "name": "metyet",
  "version": "1.0.0",
  "private": true,
  "description": "MetYet \u2014 one shared domain, two persona experiences (Trusted Partner and Collector)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node build-all.mjs && node tests/fixture-build.mjs",
    "dev": "node dev-server.mjs",
    "start": "node server/index.js",
    "db:status": "node server/cli.js status",
    "db:migrate": "node server/cli.js migrate",
    "db:bootstrap": "node server/cli.js bootstrap",
    "account:link": "node server/cli.js link-account",
    "account:list": "node server/cli.js accounts",
    "partner:invite": "node server/cli.js invite-partner",
    "partner:invitations": "node server/cli.js invitations",
    "partner:revoke": "node server/cli.js revoke-invitation",
    "auth:check": "node server/cli.js auth-check",
    "auth:sign-in": "node server/cli.js sign-in",
    "partner:register": "node server/cli.js register-partner",
    "api:view": "node server/cli.js view",
    "test": "node tests/all.cjs",
    "prod": "node prod.build.mjs",
    "build:site": "node site.build.mjs",
    "build:app": "node app.build.mjs",
    "smoke": "node tests/prod-smoke.mjs",
    "previews": "node build-preview.mjs && node build-preview-unified.mjs",
    "verify": "npm run build && npm test && npm run prod && npm run smoke && npm run previews",
    "ux:mobile-review": "node harness/mobile-ux-review.cjs",
    "ux:mobile-review:assert": "node harness/mobile-ux-review.cjs --assert-only"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "fastify": "^5.12.4",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "playwright": "^1.56.0"
  }
}