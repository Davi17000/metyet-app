node_modules/

# Build output. Everything here is regenerated by `npm run build` and
# `npm run previews` from canonical source — never edit it, never rely on it
# being present in a fresh checkout.
dist/

# Dev-server bundle (esbuild requires it beside the served HTML)
dev/main.js
dev/main.js.map
.DS_Store

# Generated by npm run build:site; published by the Pages workflow.
site/

# generated UX review assets — evidence, never source
artifacts/

# superseded: preview output moved to dist/ and this was never regenerated
previews/

# Where `npm run auth:sign-in` puts an access token, 0600, for `auth:check` to
# read and for you to delete. Never a place for anything that has to survive:
# the directory is ignored precisely because everything in it is a credential.
# sign-in refuses to write outside somewhere git ignores.
.secrets/
